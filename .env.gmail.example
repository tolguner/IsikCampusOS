# Gmail SMTP settings for auth-service.
# Copy this file to .env and replace MAIL_PASSWORD with a Gmail App Password.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=isikcampusos@gmail.com
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_FROM=isikcampusos@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_ENABLED=true
