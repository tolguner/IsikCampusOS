# IsikCampusOS — ortam değişkenleri örneği
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun. `.env` git'e gönderilmez.
#
#   cp .env.example .env
#
# Mail (Gmail SMTP) ayarları için ayrıca `.env.gmail.example` dosyasına bakın.

# ---------------------------------------------------------------------------
# JWT imzalama anahtarı (ZORUNLU)
# ---------------------------------------------------------------------------
# Tüm servisler ve API Gateway AYNI değeri kullanmalıdır; aksi halde token
# doğrulaması başarısız olur. En az 32 karakter / 256 bit önerilir.
# Güçlü bir değer üretmek için:
#   openssl rand -hex 32
# Ayarlanmazsa docker compose ve servisler başlatılırken hata verir (fail-fast).
JWT_SECRET=degistirin_openssl_rand_hex_32_ile_uretin

# ---------------------------------------------------------------------------
# PostgreSQL kimlik bilgileri (opsiyonel)
# ---------------------------------------------------------------------------
# Ayarlanmazsa yerel geliştirme için varsayılan değerler kullanılır. Üretim
# benzeri bir ortama kurulum yapıyorsanız MUTLAKA kendi değerlerinizi verin.
# POSTGRES_USER / POSTGRES_PASSWORD veritabanı konteynerini,
# SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD servisleri besler;
# ikisi aynı değer olmalıdır.
POSTGRES_USER=campusos
POSTGRES_PASSWORD=campusospassword
SPRING_DATASOURCE_USERNAME=campusos
SPRING_DATASOURCE_PASSWORD=campusospassword
